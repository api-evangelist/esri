{
  "opencollection": "1.0.0",
  "info": {
    "name": "Esri ArcGIS Location Services Auth API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Exchange OAuth credentials for an ArcGIS access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://geocode-api.arcgis.com/arcgis/rest/services/sharing/rest/oauth2/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                },
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "code",
                  "value": ""
                },
                {
                  "name": "refresh_token",
                  "value": ""
                },
                {
                  "name": "redirect_uri",
                  "value": ""
                },
                {
                  "name": "expiration",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Exchange OAuth credentials for an ArcGIS access token"
        }
      ]
    }
  ],
  "bundled": true
}